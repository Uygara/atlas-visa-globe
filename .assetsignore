# Not part of the website: internal notes, the Capacitor shell, editor config.
# Cloudflare deploys the repo root as static assets, so anything listed here stays private.
app/
*.md
docs/
.claude/
.secrets/
store/
# Repo history and local tooling: never part of the site, and the git pack can pass the 25 MiB asset limit.
.git/
node_modules/
.wrangler/
.autopilot/
# Build, data-job and test code: the browser loads build/, assets/ and data/ only.
# Keep social/ public: scripts/ig-publish.js hands Instagram the image URLs under /social/queue/.
backend/
scripts/
tools/
components/
app.jsx
.github/
firebase.json
.firebaserc
firestore.rules
wrangler.jsonc
.gitignore
.assetsignore
