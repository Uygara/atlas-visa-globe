rules_version = '2';

// Firestore security rules for travelnow.info accounts (assets/account.js).
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// One document per signed-in person: users/{uid} = { v: 1, updatedAt, data }.
// Nobody can read or write anyone else's document, and nothing else exists.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'data'])
        && request.resource.data.v == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 20;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
