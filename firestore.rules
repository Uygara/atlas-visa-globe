rules_version = '2';

// Firestore security rules for travelnow.info accounts (assets/account.js).
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// One document per signed-in person: users/{uid} = { v: 1, updatedAt, data }.
// Nobody can read or write anyone else's document, and nothing else exists.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'data'])
        && request.resource.data.v == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 20;
    }

    // Push tokens of the person's phones (the app writes them; the daily job reads
    // them and keeps its own `sent` / `lastPush` bookkeeping via the Admin SDK, which
    // bypasses these rules). One small document per token: platform, language, time
    // zone (for quiet hours) and updatedAt — nothing else can be stored by the app.
    match /users/{uid}/devices/{token} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'lang', 'tz', 'updatedAt', 'sent', 'lastPush'])
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && (!('tz' in request.resource.data) || (request.resource.data.tz is string && request.resource.data.tz.size() <= 40))
        && (!('sent' in request.resource.data) || (request.resource.data.sent is list && request.resource.data.sent.size() <= 80))
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
